# ---------------------------------------------------------------------------
# DEMap .gitignore
#
# NOTE ON DATA: every dataset this project uses is PUBLIC. Nothing below is
# excluded for privacy. Exclusions here are about repository size and about
# keeping generated output out of version control. Small public fixtures,
# schemas, manifests and dataset registries are deliberately TRACKED — see the
# un-ignore rules at the bottom.
# ---------------------------------------------------------------------------

# Scratch: session working space, never part of the published repository.
.scratch/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
*.swp

# ---------------------------------------------------------------------------
# Generated and large scientific outputs
# ---------------------------------------------------------------------------

# Experiment artifact roots (regenerated by the workflows; GBs in size).
artifacts/
runs/
logs/
outputs/

# Bulk data. Public, but far too large to version: caDSR XML exports, the
# production catalog, benchmark pair tables, candidate/feature parquets.
data/raw/
data/interim/
data/processed/

# Model weights and embedding caches.
*.safetensors
*.bin
*.pt
*.ckpt
*.joblib
*.pkl
*.npy
*.npz

# Rendered figures. These are build output: the generators live in
# src/demap_repro/reporting/figures/ and the published copies live with the
# manuscript. A few were committed by accident when migrating scripts whose
# module bodies executed on import.
*.pdf
*.png
*.svg
*.eps

# Large columnar/compressed formats anywhere outside the fixture directory.
*.parquet
*.feather
*.zip
*.tar
*.tar.gz

# ---------------------------------------------------------------------------
# Intentionally TRACKED public fixtures and metadata
#
# These are small, public, and needed for the regression tests and for readers
# to audit the pipeline without downloading anything.
# ---------------------------------------------------------------------------
!tests/fixtures/
!tests/fixtures/**
!manifests/
!manifests/**
!configs/
!configs/**
!docs/
!docs/**
!workflows/
!workflows/**
